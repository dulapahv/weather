{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "weather",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-29",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "keep_names": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "env": {
    "dev": {
      "name": "weather-dev",
      "routes": [
        {
          "pattern": "weather-dev.dulapahv.dev",
          "custom_domain": true
        }
      ],
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "weather-dev"
        }
      ]
    },
    "production": {
      "name": "weather",
      "routes": [
        {
          "pattern": "weather.dulapahv.dev",
          "custom_domain": true
        }
      ],
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "weather"
        }
      ]
    }
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true
    }
  }
}
