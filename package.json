{
  "name": "weather",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --cache",
    "lint:fix": "eslint --fix --cache",
    "format": "prettier --write **/*.{js,mjs,jsx,ts,tsx,json,css,scss}",
    "test": "vitest --watch=false",
    "test:watch": "vitest --watch",
    "preview": "opennextjs-cloudflare build --minify && opennextjs-cloudflare preview",
    "deploy:dev": "opennextjs-cloudflare build --minify && opennextjs-cloudflare deploy --env=dev",
    "deploy:prod": "opennextjs-cloudflare build --minify && opennextjs-cloudflare deploy --env=production",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "**/*.{js,mjs,jsx,ts,tsx,json,css,scss}": [
      "pnpm format",
      "pnpm lint:fix"
    ]
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "next": "16.2.9",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "swr": "^2.4.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^21.2.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@opennextjs/cloudflare": "^1.20.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.9",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.9",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "msw": "^2.14.6",
    "prettier": "^3.9.4",
    "sass": "^1.101.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9",
    "wrangler": "^4.106.0"
  },
  "packageManager": "pnpm@10.34.4+sha512.8768be55200ae3f2226b6527fcca2687e14bc4e5f12d7721a0f25da3df47915177058648db4177baf348120fa0ba2752d8d8d93f6beaf1fe64ae18da8de961af"
}
